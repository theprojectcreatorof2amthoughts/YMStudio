stash playing == no
stash recording == no
stash position == 0
stash loop_enabled == no

define transport_play
    playing == yes
done

define transport_pause
    playing == no
done

define transport_stop
    playing == no
    recording == no
    position == 0
done

define transport_record
    recording == yes
    playing == yes
done

define transport_loop
    loop_enabled == yes
done
